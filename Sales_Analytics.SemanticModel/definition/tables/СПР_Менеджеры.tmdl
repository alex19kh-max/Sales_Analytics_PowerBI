table СПР_Менеджеры
	lineageTag: 89ed0566-0469-40dd-b569-72349339a7ec

	column Регион
		dataType: string
		lineageTag: d471621d-92b3-44a9-b824-f56af9aac410
		summarizeBy: none
		sourceColumn: Регион

		annotation SummarizationSetBy = Automatic

	column Менеджер
		dataType: string
		lineageTag: 7ec1270c-1ce6-4a53-be8f-820813e80939
		summarizeBy: none
		sourceColumn: Менеджер

		annotation SummarizationSetBy = Automatic

	partition СПР_Менеджеры = m
		mode: import
		source = ```
				let
				    // 1. Берем наш базовый источник (книгу Excel из интернета)
				    Source = _ИсточникДанных,
				    
				    // 2. Оставляем только строки, которые являются листами (Sheet)
				    OnlySheets = Table.SelectRows(Source, each ([Kind] = "Sheet")),
				    
				    // 3. Удаляем служебные столбцы, оставляем только Имя листа и Данные
				    RemovedColumns = Table.SelectColumns(OnlySheets,{"Name", "Data"}),
				    
				    // 4. Автоматически применяем функцию fxОчиститьТаблицу ко всем листам сразу
				    CleanedData = Table.TransformColumns(RemovedColumns, {{"Data", each fxОчиститьТаблицу(_), type table}}),
				    
				    // 5. ИСПРАВЛЕНИЕ: Переименовываем столбец "Data" в "Value" для корректной работы Record.FromTable
				    RenamedForRecord = Table.RenameColumns(CleanedData,{{"Data", "Value"}}),
				    
				    // 6. Превращаем результат в структуру записей для мгновенного извлечения
				    TableRecord = Record.FromTable(RenamedForRecord),
				    // 6. Превращаем результат в структуру записей для мгновенного извлечения
				    СПР_Менеджеры1 = TableRecord[СПР_Менеджеры]
				in
				    СПР_Менеджеры1
				```

	annotation PBI_NavigationStepName = Навигация

	annotation PBI_ResultType = Table

