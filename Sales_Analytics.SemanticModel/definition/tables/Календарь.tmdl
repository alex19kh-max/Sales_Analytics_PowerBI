	partition Календарь-Calculated = calculated
		source = ```
				
				ADDCOLUMNS (
				    CALENDARAUTO(),
				    "Год", YEAR ( [Date] ),
				    "НомерМесяца", MONTH ( [Date] ),
				    "Месяц", FORMAT ( [Date], "MMMM", "ru-RU" ),
				    "Квартал", "Кв. " & FORMAT ( [Date], "Q" )
				)
				
				```

